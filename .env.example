# Copy to .env for local testing:  cp .env.example .env
# (.env is gitignored. In GitHub, set these as repository secrets instead.)

# --- Required for sending alerts ---
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# --- Optional (defaults shown) ---
# THRESHOLD_PCT=50        # % move since last check that triggers an alert
# DIRECTION=up            # "up" = only rises; "any" = rises or falls
# DRY_RUN=false           # true = log alerts instead of sending to Telegram
# MAX_WORKERS=8           # concurrent price requests
